# Apache 2.4+; preserve WordPress rewrite rules when adapting to an existing site.
<Files "wp-config.php">
    Require all denied
</Files>
<FilesMatch "^(\\.htaccess|\\.htpasswd|readme\\.html|license\\.txt)$">
    Require all denied
</FilesMatch>
<FilesMatch "\\.(sql|bak|old|orig|save|swp|zip|tar|gz)$">
    Require all denied
</FilesMatch>
Options -Indexes
